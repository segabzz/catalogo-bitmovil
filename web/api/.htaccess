# ==============================================================================
# SEGURIDAD BACKEND BITMOVIL: BLOQUEO DE ARCHIVOS SENSIBLES Y CACHÉ
# ==============================================================================

# Deshabilitar listado de directorios
Options -Indexes

# Bloquear acceso a archivos de configuración, entorno, logs y caché
<FilesMatch "^(secrets\.env|\.env|.*\.log|.*\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permitir exclusivamente la ejecución de scripts PHP públicos autorizados
<FilesMatch "^(chat\.php)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
