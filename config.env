# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA BITMOVIL: MCP SYSCOM & ASISTENTE LLM
# ==============================================================================
#
# Instrucciones para el Administrador:
# Rellena los siguientes valores con la URL y credenciales de tu MCP/servicio de Syscom
# y de tu LLM para habilitar la descarga automática y el chat inteligente.
#

# ------------------------------------------------------------------------------
# 1. MCP / SERVICIO DE SYSCOM
# ------------------------------------------------------------------------------
# URL base del endpoint de tu MCP o microservicio de Syscom
# Ejemplo: http://localhost:8000/v1 o https://mcp-syscom.tudominio.com/api
SYSCOM_MCP_ENDPOINT=http://localhost:8000/v1

# Token o API Key de autenticación que requiera tu servicio
SYSCOM_MCP_API_KEY=tu_token_aqui

# Activar o desactivar descargas automáticas
DOWNLOAD_IMAGES=true
DOWNLOAD_DATASHEETS=true

# ------------------------------------------------------------------------------
# 2. ASISTENTE LLM (CHAT EXPERTO EN CABLEADO Y REDES)
# ------------------------------------------------------------------------------
# Endpoint para el widget de chat (formato estándar OpenAI / Anthropic / Custom)
LLM_ENDPOINT=https://api.tu-servidor.com/v1/chat/completions

# API Key para el LLM
LLM_API_KEY=tu_token_llm_aqui

# Modelo a utilizar
LLM_MODEL=claude-3-5-sonnet-20241022
