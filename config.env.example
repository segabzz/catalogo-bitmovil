# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN BITMOVIL (config.env.example)
# ==============================================================================
# IMPORTANTE: Copia este archivo como 'config.env' y rellena tus credenciales reales.
# Nunca subas 'config.env' a tu repositorio Git.
#

# ------------------------------------------------------------------------------
# 1. MCP / API OFICIAL DE SYSCOM
# ------------------------------------------------------------------------------
# Obtén tus credenciales en https://developers.syscom.mx/
SYSCOM_CLIENT_ID=tu_client_id_aqui
SYSCOM_CLIENT_SECRET=tu_client_secret_aqui

# Endpoint de tu MCP de Syscom (si usas servidor intermedio JSON-RPC o REST)
SYSCOM_MCP_ENDPOINT=http://localhost:8000/v1
SYSCOM_MCP_API_KEY=tu_token_mcp_aqui

# Banderas de descarga automática
DOWNLOAD_IMAGES=true
DOWNLOAD_DATASHEETS=true

# ------------------------------------------------------------------------------
# 2. PROXY DE ASISTENTE LLM (ANTHROPIC CLAUDE)
# ------------------------------------------------------------------------------
# NOTA DE SEGURIDAD CRÍTICA:
# Configura una clave exclusiva para este proyecto y asígnale un límite de gasto
# mensual estricto en https://console.anthropic.com/settings/limits para evitar costos imprevistos.
ANTHROPIC_API_KEY=tu_anthropic_api_key_aqui
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Límite global diario de peticiones procesadas por el servidor (blindaje de costos)
DAILY_REQUEST_CAP=500
